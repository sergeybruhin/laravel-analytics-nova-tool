{
    "name": "sergeybruhin/laravel-analytics-nova-tool",
    "description": "Laravel Nova 4/5 resources, metrics, dashboard and filterable report Tool for sergeybruhin/laravel-analytics visitor/session/pageview/event data",
    "keywords": ["sergeybruhin", "laravel-analytics-nova-tool", "laravel", "nova", "analytics"],
    "homepage": "https://github.com/sergeybruhin/laravel-analytics-nova-tool",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Sergey Bruhin",
            "email": "sundaycreative@gmail.com",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/sergeybruhin/laravel-analytics-nova-tool/issues",
        "source": "https://github.com/sergeybruhin/laravel-analytics-nova-tool"
    },
    "require": {
        "php": "^8.2",
        "laravel/nova": "^4.0|^5.0",
        "sergeybruhin/laravel-analytics": "^0.0.1"
    },
    "autoload": {
        "psr-4": {
            "SergeyBruhin\\NovaAnalytics\\": "src"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.1.x-dev"
        },
        "laravel": {
            "providers": [
                "SergeyBruhin\\NovaAnalytics\\Providers\\NovaAnalyticsServiceProvider"
            ]
        }
    }
}
